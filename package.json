{
	"name": "obsidian-local-font-loader",
	"version": "1.8.0",
	"private": true,
	"description": "Load local fonts (TTF/OTF/WOFF/WOFF2) straight from your vault. Manage UI, text, code, and math fonts separately, plus independent editor / reading view / interface font sizes. Support cross-device font presets.",
	"author": "CoreVortex",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/lmce72/obsidian-local-font-loader.git"
	},
	"scripts": {
		"build": "esbuild src/main.ts --bundle --outfile=main.js --target=es2022 --format=cjs --external:obsidian",
		"dev": "esbuild src/main.ts --bundle --outfile=main.js --target=es2022 --format=cjs --external:obsidian --watch",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"sync-version": "bun run scripts/sync-version.mjs",
		"publish-release": "bun run scripts/publish-release.mjs"
	},
	"devDependencies": {
		"@types/node": "24.12.2",
		"esbuild": "^0.28.2",
		"obsidian": "1.13.1",
		"typescript": "7.0.2"
	}
}
